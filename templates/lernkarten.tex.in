% Lernkarten-Template — wird von scripts/build_pdf.py befüllt (string.Template)
% A4, 2 x 4 Karten je ${kb} x ${kh} mm, absolut positioniert via TikZ-Overlay.
% Seitenrand: ${rand} mm (Option --rand des Build-Scripts; 0 = randlos).
% Vorderseiten- und Rückseitenseiten wechseln sich ab; Rückseiten
% spaltengespiegelt für Duplexdruck "über lange Kante spiegeln".
% Achtung: braucht zwei pdflatex-Läufe (remember picture).
\documentclass[10pt]{article}
\usepackage[a4paper,margin=0pt]{geometry}
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage[ngerman]{babel}
\usepackage{lmodern}
\usepackage{amsmath,amssymb}
\usepackage{xcolor}
\usepackage{tikz}

\pagestyle{empty}
\setlength{\parindent}{0pt}

\newlength{\KB}\setlength{\KB}{${kb}mm}   % Kartenbreite
\newlength{\KH}\setlength{\KH}{${kh}mm}   % Kartenhöhe

% Schnittlinien (vom Build-Script aus Rand + Raster berechnet)
\newcommand{\schnittlinien}{%
$schnittlinien}

% Vorderseite: #1 Kopfzeile (Thema · Unterthema), #2 Inhalt, #3 Kartennummer
\newcommand{\karteV}[3]{%
  \begin{minipage}[t][\KH][s]{\KB}%
    \vspace*{3.5mm}%
    {\centering\scriptsize\textcolor{gray!60!black}{#1}\par}%
    \vfill
    {\centering\begin{minipage}{\dimexpr\KB-13mm\relax}\centering #2\end{minipage}\par}%
    \vfill
    {\raggedleft\tiny\textcolor{gray!60}{#3}\hspace*{3.5mm}\par}%
    \vspace*{2.5mm}%
  \end{minipage}}

% Rückseite: #1 Inhalt, #2 Quelle, #3 Kartennummer
\newcommand{\karteR}[3]{%
  \begin{minipage}[t][\KH][s]{\KB}%
    \vspace*{3.5mm}%
    {\centering\scriptsize\textcolor{white}{.}\par}% Platzhalter, Höhe wie Kopfzeile
    \vfill
    {\centering\begin{minipage}{\dimexpr\KB-13mm\relax}\centering #1\end{minipage}\par}%
    \vfill
    {\hspace*{3.5mm}\scriptsize\textcolor{gray!60!black}{#2}\hfill\tiny\textcolor{gray!60}{#3}\hspace*{3.5mm}\par}%
    \vspace*{2.5mm}%
  \end{minipage}}

% Eine Karte an absoluter Position setzen: #1 x in mm (linke Kante),
% #2 y in mm (obere Kante, von Seitenoberkante gemessen), #3 Karteninhalt
\newcommand{\zelle}[3]{%
  \node[anchor=north west, inner sep=0pt] at (#1mm, -#2mm) {#3};}

\begin{document}

$inhalt

\end{document}
