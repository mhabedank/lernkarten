% Flashcard template — filled in by scripts/build_pdf.py (string.Template).
% A4 with 2 x 4 cards of ${cw} x ${ch} mm, absolutely positioned via a TikZ overlay.
% Page margin: ${margin} mm (--margin option of the build script; 0 = borderless).
% Front pages and back pages alternate; back pages are column-mirrored so that
% duplex printing with "flip on long edge" lines them up.
% Note: needs two pdflatex runs (remember picture).
\documentclass[10pt]{article}
\usepackage[a4paper,margin=0pt]{geometry}
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage[${language}]{babel}
\usepackage{lmodern}
\usepackage{amsmath,amssymb}
\usepackage{xcolor}
\usepackage{tikz}

\pagestyle{empty}
\setlength{\parindent}{0pt}

\newlength{\CW}\setlength{\CW}{${cw}mm}   % card width
\newlength{\CH}\setlength{\CH}{${ch}mm}   % card height

% Brand mark: two stacked cards, drawn with TikZ so the build needs no image
% file. Roughly 4.6 x 2.5 mm, printed in gray on the front of every card.
\newcommand{\logomark}{%
  \begin{tikzpicture}[x=1mm, y=1mm, line width=0.2mm, baseline=0mm]
    \draw[gray!45, rounded corners=0.4mm, rotate around={-14:(1.7,1.55)}]
      (0.15,0.45) rectangle (3.25,2.65);
    \fill[white] (1.45,0) rectangle (4.55,2.3);
    \draw[gray!65, rounded corners=0.4mm] (1.45,0) rectangle (4.55,2.3);
    \node[gray!65, inner sep=0pt, font=\fontsize{4}{4}\selectfont\bfseries]
      at (3.0,1.18) {?};
  \end{tikzpicture}}

% Cut lines (computed by the build script from margin + grid)
\newcommand{\cutlines}{%
$cutlines}

% Front: #1 header (topic . subtopic), #2 content, #3 card number
\newcommand{\cardfront}[3]{%
  \begin{minipage}[t][\CH][s]{\CW}%
    \vspace*{3.5mm}%
    {\centering\scriptsize\textcolor{gray!60!black}{#1}\par}%
    \vfill
    {\centering\begin{minipage}{\dimexpr\CW-13mm\relax}\centering #2\end{minipage}\par}%
    \vfill
    {\hspace*{3.5mm}${logo}\hfill\tiny\textcolor{gray!60}{#3}\hspace*{3.5mm}\par}%
    \vspace*{2.5mm}%
  \end{minipage}}

% Back: #1 content, #2 source, #3 card number
\newcommand{\cardback}[3]{%
  \begin{minipage}[t][\CH][s]{\CW}%
    \vspace*{3.5mm}%
    {\centering\scriptsize\textcolor{white}{.}\par}% spacer, same height as the header
    \vfill
    {\centering\begin{minipage}{\dimexpr\CW-13mm\relax}\centering #1\end{minipage}\par}%
    \vfill
    {\hspace*{3.5mm}\scriptsize\textcolor{gray!60!black}{#2}\hfill\tiny\textcolor{gray!60}{#3}\hspace*{3.5mm}\par}%
    \vspace*{2.5mm}%
  \end{minipage}}

% Place one card at an absolute position: #1 x in mm (left edge),
% #2 y in mm (top edge, measured from the top of the page), #3 card content
\newcommand{\cell}[3]{%
  \node[anchor=north west, inner sep=0pt] at (#1mm, -#2mm) {#3};}

\begin{document}

$body

\end{document}
