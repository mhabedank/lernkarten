#!/usr/bin/env python3
"""The lernkarten command — everything the skills call.

    lernkarten build cards/*.yaml -o output/cards.pdf
    lernkarten check cards/*.yaml
    lernkarten engine --check
    lernkarten deps --check
    lernkarten id --backfill cards/*.yaml

`build` and `check` take the same options; see `lernkarten build --help`.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

COMMANDS = {"build", "check", "engine", "deps", "id"}


def main():
    argv = sys.argv[1:]
    command = argv[0] if argv else ""
    if command not in COMMANDS:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(0 if command in ("-h", "--help", "help") else 2)

    if command == "engine":
        import engine

        sys.argv = ["lernkarten engine", *argv[1:]]
        engine.main()
        return

    if command == "deps":
        import deps

        sys.argv = ["lernkarten deps", *argv[1:]]
        deps.main()
        return

    if command == "id":
        import deps

        try:
            deps.activate()
        except deps.DependencyError as e:
            sys.exit(f"ERROR: {e}")
        import cardid

        sys.argv = ["lernkarten id", *argv[1:]]
        sys.exit(cardid.main())

    # Anything that actually does work gets its dependencies first. There are
    # none today, so this returns immediately; when the first one arrives it is
    # installed here, once, rather than crashing with an ImportError.
    import deps

    try:
        deps.activate()
    except deps.DependencyError as e:
        sys.exit(f"ERROR: {e}")

    import build_pdf

    rest = argv[1:]
    if command == "check" and "--check" not in rest:
        rest.append("--check")
    sys.argv = ["lernkarten build", *rest]
    build_pdf.main()


if __name__ == "__main__":
    main()
