# --- Your own content stays local ---------------------------------------
# This repo is subject-agnostic: it holds the tools, not the knowledge.
# Sources, ingested texts, the catalog and your cards belong to you and are
# never versioned.
sources.yaml
# What you are trying to learn is as personal as where you read it.
goal.md
knowledge/*
!knowledge/.gitkeep
catalog/*
!catalog/.gitkeep
cards/*
!cards/.gitkeep
!cards/example.yaml
# The pictures /ingest keeps. Somebody else's diagram is theirs, and a public
# repo is the wrong place for it — user content, like everything above.
figures/*
!figures/.gitkeep
output/

# The demo project under tests/ is the exception: invented content, written for
# this repo, and the input of the end-to-end tests. `sources.yaml` above matches
# at every level, so the fixture register has to be let back in.
!tests/fixtures/**/sources.yaml
# `goal.md` has no slash either, so it matches at every level too.
!tests/fixtures/**/goal.md

# Its binary half — PDFs, the scan, the infographic, the DOCX, the attachments
# of the fake Zotero library — is generated from the text sources next to it:
#   python3 scripts/make_testdata.py
tests/fixtures/demo-project/raw/handbook/
tests/fixtures/demo-project/raw/images/
tests/fixtures/demo-project/raw/office/
tests/fixtures/demo-project/raw/field-notes/harbour-log.txt
tests/fixtures/demo-project/raw/field-notes/diagrams/
tests/fixtures/demo-project/raw/web/harbour-plan.png
tests/fixtures/zotero/storage/

# --- Build leftovers ----------------------------------------------------
*.aux
*.log
*.out
*.pdf
# The printable card box is not a build leftover — it is a shipped deliverable,
# published with the landing page. It has no source in this repo and cannot be
# regenerated, which is why Principle VIII names it explicitly. This negation
# has to stay *below* `*.pdf`: .gitignore is last-match-wins.
!assets/card-box.pdf

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# --- System -------------------------------------------------------------
.DS_Store

# --- Claude Code --------------------------------------------------------
.claude/settings.local.json
# Worktrees are whole checkouts of this repo. They never belong in it.
.claude/worktrees/

# --- Spec-kit -----------------------------------------------------------
# .specify/ is versioned: the constitution and the templates are project rules,
# and rules that only live on one machine are not rules. The catalog cache is
# a download with timestamps in it, so that part stays out.
.specify/extensions/.cache/
