# --- Your own content stays local ---------------------------------------
# This repo is subject-agnostic: it holds the tools, not the knowledge.
# Sources, ingested texts, the catalog and your cards belong to you and are
# never versioned.
sources.yaml
knowledge/*
!knowledge/.gitkeep
catalog/*
!catalog/.gitkeep
cards/*
!cards/.gitkeep
!cards/example.yaml
output/

# --- Build leftovers ----------------------------------------------------
*.aux
*.log
*.out
*.pdf

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# --- System -------------------------------------------------------------
.DS_Store

# --- Claude Code --------------------------------------------------------
.claude/settings.local.json
