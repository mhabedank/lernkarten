#!/bin/sh
# Keeps user content out of the repo — the same thing CI checks later.
#
# Install with: scripts/install-hooks.sh

forbidden=$(git diff --cached --name-only --diff-filter=A \
    | grep -E '^(knowledge/|catalog/|cards/|output/|sources\.yaml)' \
    | grep -v -E '^(knowledge/\.gitkeep|catalog/\.gitkeep|cards/\.gitkeep|cards/example\.yaml)$')

if [ -n "$forbidden" ]; then
    echo "✗ These files do not belong in the repo (your own content stays local):" >&2
    echo "$forbidden" | sed 's/^/    /' >&2
    echo "  See .gitignore and CONTRIBUTING.md. If you must: git commit --no-verify" >&2
    exit 1
fi

exit 0
