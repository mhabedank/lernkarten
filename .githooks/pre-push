#!/bin/sh
# Blocks direct pushes to main before they even reach the server.
# main is protected server-side as well — this just saves the round trip.
#
# Install with: scripts/install-hooks.sh

PROTECTED="main"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        "refs/heads/$PROTECTED")
            echo "✗ Pushing to '$PROTECTED' is blocked." >&2
            echo "  Create a branch and open a pull request:" >&2
            echo "    git switch -c my-change" >&2
            echo "    git push -u origin my-change && gh pr create" >&2
            exit 1
            ;;
    esac
done

exit 0
